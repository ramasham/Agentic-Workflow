
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp",
        "oauth": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "--no-install",
          "@playwright/mcp",
          "--headless"
        ]
      }
    }
  }
}
